# ── Environment ──────────────────────────────────────────────────────────────
# REQUIRED: the API, gateway and all-in-one process refuse to start without it
# (an unset NODE_ENV used to mean development). This file ships PRODUCTION, because
# it is the template for /etc/plugsure/plugsure.env too, and systemd's EnvironmentFile=
# overrides the units' own Environment=NODE_ENV=production.
#
# On a workstation set NODE_ENV=development (bench security profile and auto-adoption
# allowed, sign-in codes shown in the driver app, gateway on 0.0.0.0, two-step
# verification optional). Never use development on a host reachable by anyone else.
NODE_ENV=production
DATABASE_URL=postgresql://postgres:plugsure@127.0.0.1:5432/plugsure
OCPP_PORT=9220
API_PORT=9200
# Listen addresses. Outside development both default to loopback (127.0.0.1):
# Caddy on the same host is the only way in. Development binds the gateway on
# 0.0.0.0 so a bench charger on the LAN can dial in directly; docker compose sets
# 0.0.0.0 inside the containers (the host port bindings decide exposure).
# API_HOST=127.0.0.1
# OCPP_HOST=127.0.0.1
LOG_LEVEL=info
TZ=Asia/Jakarta

# Bench convenience. BOTH of these are wrong for production — see deploy/README.md.
# Outside NODE_ENV=development/test the gateway refuses to start with them unless
# ALLOW_INSECURE_OCPP=true is set (a supervised bench only).
OCPP_MIN_SECURITY_PROFILE=0
OCPP_AUTO_ADOPT=true

# ── Database roles ───────────────────────────────────────────────────────────
# Migrations run as the OWNER (they issue DDL). The API and gateway run as a
# NON-SUPERUSER, because a superuser bypasses every row-level security policy and
# the app refuses to start in production as one. Set this and `npm run migrate`
# provisions the role; then point DATABASE_URL at it for the app processes.
POSTGRES_APP_USER=plugsure_app
# Docker Compose (Path A): the database superuser password. Required, no default: generate one
# (openssl rand -base64 24). docker compose refuses to start without it.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
# systemd path (v1.4.4): the owner connection for migrations does NOT go in this file.
# It goes in the root-only /etc/plugsure/migrate.env as DATABASE_URL (with
# POSTGRES_APP_PASSWORD), read only by plugsure-migrate.service, so the running API and
# gateway never hold the owner password. Here DATABASE_URL is the plugsure_app
# connection. See deploy/README.md §4-5.
# How long one migration may wait for a table lock before it fails (and rolls back)
# instead of queueing every query behind it. Postgres duration; 0 = wait forever.
# MIGRATION_LOCK_TIMEOUT=10s

# ── Secrets ──────────────────────────────────────────────────────────────────
# Outside NODE_ENV=development these have NO default and the process exits at
# boot without them. Generate with `openssl rand -hex 32`.
#
# AUDIT_HMAC_KEY keys the audit log's hash chain; without it the chain is only a
# checksum that anyone who can write to the table can forge. Rotating it stops
# every previously written entry from verifying — export and re-anchor first.
AUDIT_HMAC_KEY=
# SECRETS_KEY encrypts webhook and payment-provider credentials at rest.
SECRETS_KEY=

# ── API ──────────────────────────────────────────────────────────────────────
# Comma-separated IPs/CIDRs whose X-Forwarded-For header is believed. Leave EMPTY
# unless you actually run behind a proxy: trusting it from anyone makes req.ip
# attacker-controlled, and req.ip is both the rate-limit key and the client IP
# written to the audit log.
API_TRUSTED_PROXIES=
# Per-API-key rate limits shared across API processes (in Postgres). Defaults to
# true outside development/test; false = each process keeps its own buckets (a key
# then gets its limit per process). Falls back per process if the database fails.
# API_RATE_LIMIT_SHARED=true

# ── Operator console (v1.3) ─────────────────────────────────────────────────
# Public HTTPS origin chargers can reach. Firmware download URLs and the built-in
# diagnostics upload URL are built from it. Required for FOTA with uploaded images.
PUBLIC_BASE_URL=
# The OCPP URL printed on commissioning exports / QR codes (without the identity),
# e.g. wss://ocpp.example.co.id/ocpp
OCPP_PUBLIC_URL=
# Session cookie is Secure (HTTPS only). Defaults to true when NODE_ENV=production.
# CONSOLE_COOKIE_SECURE=true
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# PASSWORD_MIN_LENGTH=12
# Two-step verification (authenticator app, TOTP) is REQUIRED for administrator
# accounts (Super Administrator, platform admin: anyone holding user management or a
# platform permission); such a user without it is made to enrol at next sign-in.
# Default true outside NODE_ENV=development/test. Wrong codes count towards the
# LOGIN_MAX_FAILURES lockout. false = optional for everyone (the API logs a warning).
# CONSOLE_MFA_REQUIRED=true
# Console host names on which ADMINISTRATOR accounts may sign in, comma-separated.
# Empty = any host. Set it when the console is also published on an internet-facing
# portal hostname (deploy/Caddyfile): administrators are then refused there.
# CONSOLE_ADMIN_HOSTS=console.example.id
# "Sign in with Microsoft" (Microsoft Entra ID) for the console — v1.6.0, optional, off
# unless MS_CLIENT_ID is set. One multi-tenant app registration for the whole platform;
# each operator then connects its own tenant in Users & Roles → Microsoft sign-in.
# Redirect URI to register in the Microsoft Entra admin center (entra.microsoft.com): PUBLIC_BASE_URL + /v1/auth/microsoft/callback
# (PUBLIC_BASE_URL must be https://). Full guide: deploy/MICROSOFT-SIGN-IN.md.
# MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# The client secret, or (preferred) a root-owned file holding it, read at each sign-in
# so a rotated secret needs no restart. Set one of the two, not both.
# MS_CLIENT_SECRET=
# MS_CLIENT_SECRET_FILE=/etc/plugsure/ms-client-secret
# Further console host names that offer the button (each registered as a redirect URI).
# MS_SIGNIN_HOSTS=console.nusantaracharge.id
# false = Microsoft MFA (amr "mfa") never replaces the console's two-step verification.
# MS_TRUST_MFA_CLAIM=true
# Microsoft sign-in requests (start + return) per client address per minute.
# MS_SIGNIN_RATE_PER_MIN=60
# Another Microsoft cloud (US Gov: https://login.microsoftonline.us). Only Microsoft hosts
# are accepted outside development/test.
# MS_AUTHORITY_BASE=https://login.microsoftonline.com
# Where uploaded firmware and retrieved diagnostic logs are stored (persistent volume).
STORAGE_DIR=./var/storage
# MAX_FIRMWARE_BYTES=536870912
# MAX_DIAGNOSTICS_BYTES=209715200

# ── API <-> gateway bridge (split deployment: api.js and gateway.js) ─────────
# Without it, console commands and live status cannot reach chargers when the
# API and the gateway run as separate processes. Same token on both processes.
# Generate with `openssl rand -hex 32`.
INTERNAL_API_TOKEN=
# On the API process: where the gateway's internal endpoints are.
GATEWAY_INTERNAL_URL=
# On the gateway process: relay live events to the API via Postgres NOTIFY.
EVENT_RELAY=false
# Background workers (load-management loop, compliance, FOTA). Run them in the
# process that owns the charger sockets: the gateway (or all-in-one). Run exactly
# ONE gateway (deploy/README.md): a second one is not supported, with or without this.
RUN_WORKERS=true
# v1.5.1 upgrade: settlement recovery ignores CDRs issued before this time (ISO timestamp).
# Set it to the upgrade time, review `npm run settlement:report`, then remove it.
# SETTLEMENT_RECOVERY_NOT_BEFORE=
# Worker health (gateway). A worker failing this many passes in a row (and for over
# a minute), or not completing a pass for 3x its interval, raises an operator alert
# ("Background worker failing", resolved when it recovers) in this organisation's
# alert list — default: the platform administrator's organisation, or the only one.
# WORKER_ALERT_FAILURES=3
# OPS_ALERT_ORG_ID=
# External dead-man's switch: GET this URL (e.g. https://hc-ping.com/<uuid>) at most
# every HEARTBEAT_INTERVAL_MS while every worker is healthy. Its silence = trouble.
# HEARTBEAT_URL=
# HEARTBEAT_INTERVAL_MS=60000
# Minutes a charger may be offline before a critical alert (and webhook). The
# alert resolves itself when the charger reconnects. Brief 4G drops stay below it.
OFFLINE_ALERT_MINUTES=15
# Retention of the OCPP message log and the connection-attempt log, in days
# (an hourly worker deletes older rows in batches; 0 keeps them forever).
# OCPP_FRAME_RETENTION_DAYS=90
# CONNECTION_ATTEMPT_RETENTION_DAYS=30

# ── Alert notifications (e-mail, WhatsApp) ───────────────────────────────────
# SMTP server, WhatsApp Business sender, contacts and rules are set in the console
# (Govern → Alert routing); their secrets are sealed with SECRETS_KEY.
# The console address put in alert messages (defaults to PUBLIC_BASE_URL).
CONSOLE_PUBLIC_URL=
# Time zone for quiet hours and the times printed in messages.
ALERT_TIMEZONE=Asia/Jakarta
# Flood guard: most messages per recipient and channel in 15 minutes.
ALERT_NOTIFY_MAX_PER_15MIN=20

# ── Platform commission and fee statements ───────────────────────────────────
# Rates per customer are set in the console (Govern → Platform billing) by a
# platform administrator: npm run create-admin -- … --platform-admin
# Issuer printed on statements.
BILLING_ISSUER_NAME=PT. RailSure Solutions Indonesia (PlugSure)
BILLING_ISSUER_NPWP=
# Calendar months are cut in this time zone.
BILLING_TIMEZONE=Asia/Jakarta

# ── Roaming (OCPI 2.2.1) ───────────────────────────────────────────────────────
# Partners, the roaming identity and shared sites are set in the console
# (Commercial → Roaming). Public origin partners call; the versions URL given to
# them is <this>/ocpi/versions (see the ocpi.* block in deploy/Caddyfile).
# Defaults to PUBLIC_BASE_URL.
OCPI_PUBLIC_URL=
# PBJT-TL is a regional tax, not VAT: by default it counts in a CDR's excl_vat.
# Set false if your tax advisor treats it otherwise. Needed on the API and the gateway.
OCPI_PBJT_IN_EXCL_VAT=true
# How long a charger's Authorize waits for a partner's real-time answer.
OCPI_REALTIME_AUTH_TIMEOUT_MS=5000

# ── PlugSure Hub (v1.8, optional): PlugSure as an OCPI 2.2.1 roaming hub ──────
# Off by default: nothing under /hub is mounted and the console shows no Hub menu.
# Runbook: deploy/HUB-OPERATIONS.md (DNS, the hub.* block in deploy/Caddyfile,
# onboarding members in Governance → Hub). Guide for members: deploy/HUB-ONBOARDING.md.
HUB_ENABLED=false
# The hub's own public origin (its own host); members' versions URL is
# <this>/hub/ocpi/versions. Defaults to OCPI_PUBLIC_URL.
HUB_PUBLIC_URL=
# The hub's parties (role HUB), one per country. Choose once: members store them.
HUB_PARTIES=ID*PSH,MY*PSH,SG*PSH
HUB_BUSINESS_NAME=PlugSure Hub
HUB_WEBSITE=
# Tenants may join from Roaming → PlugSure Hub themselves (else a platform admin joins them).
HUB_SELF_JOIN=false
# Deadlines of forwarded requests (then OCPI 4002); real-time authorisation stays
# below OCPI_REALTIME_AUTH_TIMEOUT_MS.
HUB_FORWARD_TIMEOUT_MS=10000
HUB_REALTIME_TIMEOUT_MS=4000
# Validity of a rewritten command response_url.
HUB_CALLBACK_TTL_S=900
# Idle minutes before a member's versions URL is checked (two failures: OFFLINE).
HUB_ALIVE_AFTER_MIN=5
# Minutes an old token keeps working after a rotation forced by the platform.
HUB_TOKEN_GRACE_MIN=60
# Alert hub.forward_error_rate: this share (%) of at least HUB_ALERT_MIN_REQUESTS
# outbound calls to one member failed in 15 minutes.
HUB_ALERT_ERROR_RATE_PCT=25
HUB_ALERT_MIN_REQUESTS=20
# Clearing and settlement [OWNER: commercial terms]. Whole days; out-of-range values refuse start-up.
# Dispute window after a CDR is received (an agreement may set its own), CPO answer, eMSP escalation,
# credit CDR after an accepted dispute, payment terms after a run is finalised.
HUB_DISPUTE_DAYS=14
HUB_DISPUTE_RESPONSE_DAYS=10
HUB_DISPUTE_ESCALATE_DAYS=5
HUB_CREDIT_DUE_DAYS=10
HUB_PAYMENT_TERMS_DAYS=14
# Settlement cycle: monthly or weekly (periods in each currency's country time zone).
HUB_CYCLE=monthly
# Issuer of fee invoices for members of a country without a PlugSure entity: ID, MY or SG.
HUB_DEFAULT_ENTITY=SG
# A CDR whose session ended more than this many days before it arrived is flagged late_cdr.
HUB_LATE_CDR_DAYS=60

# ── Driver app: map, push notifications, reservations ────────────────────────
# Map tiles for the station map ({z}/{x}/{y}, optional {s}). The OpenStreetMap
# Foundation's own server is for light use only; a busy deployment should use its
# own or a commercial tile service. The CSP img-src follows this host.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
# Web Push (VAPID). Leave both empty: a key pair is generated once and stored in
# the database, sealed with SECRETS_KEY, so the API and gateway share it. Set them
# only to bring an existing key (base64url P-256; changing it re-subscribes phones).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach about this sender (mailto: or https:).
VAPID_SUBJECT=mailto:ops@plugsure.id
# Push service hosts (suffix match) notifications may go to in production.
# The phone's browser supplies the endpoint, so this is an SSRF allow-list.
PUSH_ALLOWED_HOSTS=fcm.googleapis.com,push.services.mozilla.com,web.push.apple.com,notify.windows.com
# Connector reservations from the app (OCPP ReserveNow). Signed-in drivers only.
DRIVER_RESERVATIONS=true
DRIVER_RESERVATION_MINUTES=15
# Unused (expired) reservations a driver may run up in 24 h before reserving is paused.
DRIVER_RESERVATION_NO_SHOW_LIMIT=2
# App Store / Google Play review sign-in (v1.9.1). Reviewers cannot receive the SMS code: a code requested for exactly
# this number is not sent, and DRIVER_REVIEW_CODE works instead (every rate limit still applies; each use is logged as
# a warning). Off unless BOTH are set. Six digits, not guessable (no 000000, 123456, 121212…), or the API refuses to
# start. Remove both once the app is approved (deploy/DRIVER-APP-PILOT.md).
DRIVER_REVIEW_PHONE=
DRIVER_REVIEW_CODE=
# CORS for browser builds of the native app on another origin (the Expo web build, a hosted preview):
# exact origins, comma-separated, driver API (/d/v1) only; https:// only in production. Empty = no CORS.
DRIVER_WEB_ORIGINS=
# The driver API (/d/) behind carrier NAT: requests a minute per device token, and per client address (abuse cap).
DRIVER_DEVICE_RATE_LIMIT_PER_MIN=600
DRIVER_IP_RATE_LIMIT_PER_MIN=6000
# Requests a minute per address WITHOUT a device token (browse, link resolver, minting a device token): v1.9.0.
DRIVER_ANON_IP_RATE_LIMIT_PER_MIN=600

# ── HashiCorp Vault PKI for Security Profile 3 (optional) ─────────────────────
VAULT_ADDR=
VAULT_TOKEN=
VAULT_PKI_MOUNT=pki
VAULT_PKI_ROLE=ocpp-charger
VAULT_CERT_TTL=8760h
# VAULT_NAMESPACE=

# ── Charger client certificates (Security Profile 3; see deploy/README.md) ────
# PlugSure's charging-station CA issues them at onboarding or over OCPP. It is
# created on first use; or use your own CA (both files, PEM):
CHARGER_CA_CERT_FILE=
CHARGER_CA_KEY_FILE=
# Default validity of charger certificates, and how early they are renewed.
CHARGER_CERT_DAYS=730
CHARGER_CERT_RENEW_DAYS=30
# Root of the OCPP host's TLS certificate, handed to chargers in the onboarding
# bundle. Leave empty for a public CA (Let's Encrypt: chargers need ISRG Root X1).
CSMS_ROOT_CA_FILE=

# ── ISO 15118 Plug & Charge (optional; see deploy/README.md "Plug & Charge") ────
# none (production default) | http (your PKI gateway) | mock (test PKI; refused in production)
PNC_PKI=none
PNC_PKI_URL=
PNC_PKI_TOKEN=
# pki (default): the PKI signs chargers' V2G certificates. vault: your own CPO
# sub-CA in Vault signs them (uses VAULT_ADDR / VAULT_TOKEN above).
PNC_V2G_SIGNER=pki
PNC_VAULT_MOUNT=pki_v2g
PNC_VAULT_ROLE=secc
# Ask chargers for a new V2G certificate this many days before it expires.
PNC_RENEW_DAYS=30
PNC_OCSP_TIMEOUT_MS=5000

# ── Billing safety bounds ────────────────────────────────────────────────────
# Hard per-session cap on idle/occupancy charges. Not a regulatory figure — a
# platform bound. Unbounded, an idle fee billed Rp 6,692,360 for 60 kWh.
IDLE_FEE_CAP_IDR=100000

# Per-charger inbound message budget (token bucket). Past it the gateway paces the charger's
# messages instead of refusing them; nothing is dropped. The burst covers a charger uploading its
# queued transactions after an outage. 0 disables it.
# OCPP_MAX_MESSAGES_PER_S=20
# OCPP_MESSAGE_BURST=200

# Hours a charger-facing firmware link keeps working after the charger's job last moved
# (links work only while a campaign needs the image, then this long).
# FIRMWARE_LINK_GRACE_HOURS=24

# ── Malaysia and Singapore ───────────────────────────────────────────────────
# Sites, tariffs and payments outside Indonesia (docs/MULTI-COUNTRY-DESIGN.md). Off: Indonesian behaviour only.
# MULTI_COUNTRY=false
# Payments in MY and SG go through Stripe, one Stripe account per country. Its keys are NOT environment variables:
# each operator (or the platform) enters them under Govern → Integrations → Payments for that country (sealed with
# SECRETS_KEY). Stripe needs PUBLIC_BASE_URL (above) for its return URLs and the webhook URL to register.
# Stripe TEST keys are refused while NODE_ENV=production unless the integration allows test mode. See deploy/STRIPE.md.
