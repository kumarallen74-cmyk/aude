# PlugSure API + operator console — systemd unit for the no-Docker deployment path.
#
# Install:
#   install -o root -g root -m 0644 deploy/plugsure-api.service \
#       /etc/systemd/system/plugsure-api.service
#   systemctl daemon-reload
#   systemctl enable --now plugsure-api
#
# The console requires sign-in (v1.3). Publish it only through Caddy on its own
# hostname with an IP allow-list (deploy/Caddyfile); keep API_HOST=127.0.0.1.
#
# Logs go to journald:  journalctl -u plugsure-api -f

[Unit]
Description=PlugSure API and operator console
Documentation=file:/opt/plugsure/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=plugsure
Group=plugsure
WorkingDirectory=/opt/plugsure

EnvironmentFile=/etc/plugsure/plugsure.env
# v1.3: uploaded firmware images and retrieved diagnostic logs (inside ReadWritePaths).
Environment=STORAGE_DIR=/var/lib/plugsure/storage
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--enable-source-maps
Environment=TZ=Asia/Jakarta

# --- migrations ---------------------------------------------------------------
# Every start runs the migrator first, in its own unit (deploy/plugsure-migrate.service),
# which alone reads the database owner's credentials from the root-only
# /etc/plugsure/migrate.env. This unit, like the gateway's, loads only
# /etc/plugsure/plugsure.env, where DATABASE_URL is the restricted plugsure_app role:
# the running API never holds the owner password (v1.4.4).
# `systemctl start` waits for the one-shot to finish and fails if it fails, so a failed
# migration fails THIS start; Restart=always then retries it (e.g. the database not
# up yet at boot), within StartLimitBurst. The '+' runs just this command with full
# privileges (systemctl needs them); the API itself stays sandboxed.
ExecStartPre=+/usr/bin/systemctl start plugsure-migrate.service
# The start timeout covers ExecStartPre, i.e. the migration (up to plugsure-migrate's
# TimeoutStartSec=600): without this the default 90 s would report a long migration as a
# failed deploy while it is still running.
TimeoutStartSec=infinity
ExecStart=/usr/bin/node /opt/plugsure/dist/apps/api.js

Restart=always
RestartSec=5

# --- shutdown -----------------------------------------------------------------
# src/apps/api.ts handles SIGTERM: Fastify stops accepting connections, drains
# in-flight requests, ends open console live streams (SSE), then closes the bridge
# and the pg pool. 30s covers a normal drain; a request still running after that
# is cut by the SIGKILL below.
#
# No ExecReload: there is no SIGHUP handler and node's default for SIGHUP is to
# terminate, so a `kill -HUP` reload would be an ungraceful restart. Configuration
# is read at start; use `systemctl restart plugsure-api`.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30
SendSIGKILL=yes

# --- logging ------------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plugsure-api

# --- limits -------------------------------------------------------------------
LimitNOFILE=16384
LimitNPROC=4096

# --- hardening ----------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
ReadWritePaths=-/var/lib/plugsure
# The owner credentials are for the migrate and backup units only (v1.4.4).
InaccessiblePaths=-/etc/plugsure/migrate.env -/etc/plugsure/backup.env
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# Must stay off — V8's JIT needs W+X pages.
MemoryDenyWriteExecute=no
UMask=0027

[Install]
WantedBy=multi-user.target
