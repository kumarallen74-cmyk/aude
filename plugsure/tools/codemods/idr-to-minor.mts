// multicountry/ holds the v1.6-side tools (golden fixtures, re-rate), written in v1.6's names on purpose.
const SKIP_DIRS = new Set(['node_modules', 'codemods', 'multicountry', '.git']);
const SKIP_FILES = new Set([
  'src/web/openapi.json',
  // These know both names on purpose (legacy reads and aliases).
  'src/domain/money.ts', 'src/domain/money.test.ts',
  'src/api/legacy-money.ts', 'src/api/legacy-money.test.ts',
  'src/services/tax/golden-id.test.ts', // replays v1.6 output, in v1.6's names
  'src/domain/country-literals.test.ts', // tests the codemod on v1.6 names
  // v1.5.0 compatibility tests: they assert the legacy names a v1.5 integration reads (docs/COMPATIBILITY-v1.5-to-v1.9.md)
  'src/api/openapi/compat-v15.test.ts', 'src/services/compat-v15.test.ts',
]);
const EXTS = new Set(['.ts', '.mts', '.js', '.html']);

function walk(dir: string, out: string[] = []): string[] {
  for (const name of readdirSync(dir)) {
    if (SKIP_DIRS.has(name)) continue;
    const p = join(dir, name);
    if (statSync(p).isDirectory()) walk(p, out);
    else if (EXTS.has(extname(name)) && !SKIP_FILES.has(relative(root, p))) out.push(p);
  }
  return out;
}

const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

export interface RenameReport { changed: boolean; text: string; renames: Map<string, string>; collisions: string[] }

/** Rewrite one file's text. Pure; `rel` selects per-file exclusions. */
export function rewrite(text: string, rel = ''): RenameReport {
  const renames = new Map<string, string>();
  const keep = new Set([...CAMEL_EXCLUDE, ...(PER_FILE_EXCLUDE[rel] ?? [])]);
  const note = (from: string, to: string) => { renames.set(from, to); return to; };

  // Lines that talk ABOUT the old names (compatibility notes: "v1.6", "1.7",
  // "legacy", "deprecated") are left alone, so the codemod stays re-runnable over
  // code written after it.
  const lines = text.split('\n');
  const kept = new Map<number, string>();
  lines.forEach((l, i) => { if (/v1\.6|\b1\.7\b|legacy|deprecated/i.test(l)) kept.set(i, l); });

  // 1. explicit snake names, longest first
  let t = text;
  for (const k of Object.keys(SNAKE_MAP).sort((a, b) => b.length - a.length)) {
    t = t.replace(new RegExp(`\\b${esc(k)}\\b`, 'g'), () => note(k, SNAKE_MAP[k]!));
  }
  // 2. generic snake: lower-case identifiers only (env var names are upper case)
  t = t.replace(/\b([a-z][a-z0-9_]*)_idr\b/g, (m, base: string) => note(m, `${base}_minor`));
  // 3. explicit camel
  for (const k of Object.keys(CAMEL_MAP).sort((a, b) => b.length - a.length)) {
    if (keep.has(k)) continue;
    t = t.replace(new RegExp(`\\b${esc(k)}\\b`, 'g'), () => note(k, CAMEL_MAP[k]!));
  }
  // 4. generic camel
  t = t.replace(/\b([a-z][A-Za-z0-9]*)Idr\b/g, (m, base: string) => (keep.has(m) ? m : note(m, `${base}Minor`)));

  if (kept.size) {
    const out = t.split('\n');
    if (out.length === lines.length) for (const [i, l] of kept) out[i] = l;
    t = out.join('\n');
  }

  // Two different old names that now share one new name in the same file deserve a look
  // (e.g. dppIdr and ppnDppIdr both become taxBaseMinor).
  const byTarget = new Map<string, string[]>();
  for (const [from, to] of renames) byTarget.set(to, [...(byTarget.get(to) ?? []), from]);
  const collisions = [...byTarget].filter(([, froms]) => froms.length > 1).map(([to, froms]) => `${froms.join(' + ')} → ${to}`);
  return { changed: t !== text, text: t, renames, collisions };
}

/**
 * The rename statements as one guarded DO block: each rename runs only while the
 * old name exists, so the file can be applied again (or after a partial manual
 * repair) without error.
 */
function guardedRenames(cols: Array<[string, string, string]>, cons: Array<[string, string, string]>, title: string): string {
  const q = (x: string) => `'${x}'`;
  const colRows = cols.map(([t, a, b]) => `    ARRAY[${q(t)}, ${q(a)}, ${q(b)}]`).join(',\n');
  const conRows = cons.map(([t, a, b]) => `    ARRAY[${q(t)}, ${q(a)}, ${q(b)}]`).join(',\n');
  return `-- ${title}
DO $$
DECLARE r TEXT[];
BEGIN
  FOREACH r SLICE 1 IN ARRAY ARRAY[
${colRows}
  ] LOOP
    IF EXISTS (SELECT 1 FROM information_schema.columns
                WHERE table_schema = current_schema() AND table_name = r[1] AND column_name = r[2]) THEN
      EXECUTE format('ALTER TABLE %I RENAME COLUMN %I TO %I', r[1], r[2], r[3]);
    END IF;
  END LOOP;
  FOREACH r SLICE 1 IN ARRAY ARRAY[
${conRows}
  ] LOOP
    IF EXISTS (SELECT 1 FROM pg_constraint WHERE conname = r[2] AND conrelid = r[1]::regclass) THEN
      EXECUTE format('ALTER TABLE %I RENAME CONSTRAINT %I TO %I', r[1], r[2], r[3]);
    END IF;
  END LOOP;
END $$;
`;
}

export function sqlUp(): string {
  return guardedRenames(COLUMN_RENAMES, CONSTRAINT_RENAMES,
    'generated by tools/codemods/idr-to-minor.mts --sql (table, old, new); reviewed by hand');
}

export function sqlDown(): string {
  const flip = (l: Array<[string, string, string]>) => [...l].reverse().map(([t, a, b]): [string, string, string] => [t, b, a]);
  return guardedRenames(flip(COLUMN_RENAMES), flip(CONSTRAINT_RENAMES),
    'generated by tools/codemods/idr-to-minor.mts --sql-down (table, new, old)');
}

/** Files the codemod would still change (empty once it has run: it is idempotent). */
export function pendingChanges(): string[] {
  return [...walk(join(root, 'src')), ...walk(join(root, 'tools'))]
    .map((f) => relative(root, f))
    .filter((rel) => rewrite(readFileSync(join(root, rel), 'utf8'), rel).changed);
}

if (import.meta.url === `file://${process.argv[1]}`) {
  const args = process.argv.slice(2);
  if (args.includes('--sql')) process.stdout.write(sqlUp());
  else if (args.includes('--sql-down')) process.stdout.write(sqlDown());
  else {
    const dry = args.includes('--dry');
    let n = 0;
    for (const file of [...walk(join(root, 'src')), ...walk(join(root, 'tools'))]) {
      const rel = relative(root, file);
      const r = rewrite(readFileSync(file, 'utf8'), rel);
      if (!r.changed) continue;
      n++;
      console.log(`${dry ? 'would change' : 'changed'} ${rel} (${r.renames.size} names)`);
      for (const c of r.collisions) console.log(`  review: ${c}`);
      if (!dry) writeFileSync(file, r.text);
    }
    console.log(`${n} file(s) ${dry ? 'would change' : 'changed'}`);
  }
}
